<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07142F"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EVC • استودیو ویرایش ویدیو"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="یک ویدیو انتخاب کنید تا ۹۰ فریم در ۶ ردیف ساخته شود"
        android:textColor="#B9D7FF"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingBottom="5dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="#000000">
        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="▶

پخش‌کنندهٔ EVC"
            android:textColor="#D7E7FF"
            android:textSize="20sp"
            android:gravity="center"
            android:background="#101F3D" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="3dp">
        <TextView
            android:id="@+id/selectionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="انتخاب‌شده: ۰ فریم از ۹۰"
            android:textColor="#FFD21F"
            android:textSize="11sp" />
        <Button
            android:id="@+id/clearSelectionButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minHeight="0dp"
            android:text="پاک‌کردن انتخاب"
            android:textSize="10sp"
            android:textColor="#07142F"
            android:backgroundTint="#FFD21F" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="vertical">
        <LinearLayout
            android:id="@+id/storyboardRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/openButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="انتخاب ویدیو"
        android:textColor="#07142F"
        android:textStyle="bold"
        android:backgroundTint="#FFD21F" />
</LinearLayout>
