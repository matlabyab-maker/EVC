<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#07142F" android:padding="3dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EVC • استودیو ویرایش ویدیو" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:gravity="center" android:paddingTop="0dp" android:paddingBottom="0dp" />

    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="یک ویدیو انتخاب کنید تا ۱۲۰ فریم در ۸ ردیف ساخته شود" android:textColor="#B9D7FF" android:textSize="12sp" android:gravity="center" android:paddingBottom="1dp" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="92dp" android:background="#000000">
        <VideoView android:id="@+id/videoView" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/playerColorPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="پیش‌نمایش رنگ فریم فعلی" android:visibility="gone" />
        <TextView android:id="@+id/emptyHint" android:layout_width="match_parent" android:layout_height="match_parent" android:text="▶  پخش‌کنندهٔ EVC" android:textColor="#D7E7FF" android:textSize="20sp" android:gravity="center" android:background="#101F3D" />
    </FrameLayout>


    
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
        <Button android:id="@+id/colorizePreviewButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:minHeight="0dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:text="خروجی رنگی" android:textSize="11sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#D7A6FF" />
        <Button android:id="@+id/exportButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:minHeight="0dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:text="بدون تغییر کدک" android:textSize="11sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#43D9A3" />
        <Button android:id="@+id/openButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="0.8" android:minHeight="0dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:text="انتخاب ویدیو" android:textSize="11sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFD21F" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp"><Button android:id="@+id/timeModeButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:text="نمایش زمانی" android:textSize="11sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:layout_marginEnd="4dp" android:layout_marginStart="0dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="4dp" android:paddingRight="4dp" />
    <Button android:id="@+id/selectAllButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_marginEnd="4dp" android:minHeight="0dp" android:text="انتخاب همه" android:textSize="11sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:layout_weight="1" android:layout_marginStart="0dp" android:minWidth="0dp" android:paddingLeft="4dp" android:paddingRight="4dp" />
        <Button android:id="@+id/clearSelectionButton" android:layout_width="0dp" android:layout_height="30dp" android:minHeight="0dp" android:text="لغو انتخاب" android:textSize="11sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:layout_weight="1" android:layout_marginEnd="0dp" android:layout_marginStart="0dp" android:minWidth="0dp" android:paddingLeft="4dp" android:paddingRight="4dp" />
        </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp"><Button android:id="@+id/deleteSelectedButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_marginStart="0dp" android:minHeight="0dp" android:text="حذف بازه‌ها" android:textSize="11sp" android:textColor="#FFFFFF" android:backgroundTint="#B52C45" android:layout_weight="0.85" android:layout_marginEnd="4dp" android:minWidth="0dp" android:paddingLeft="4dp" android:paddingRight="4dp" />
    <Button android:id="@+id/selectForDeleteModeButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1.15" android:text="انتخاب برای حذف" android:textSize="11sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:layout_marginEnd="4dp" android:layout_marginStart="0dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="4dp" android:paddingRight="4dp" />
        <Button android:id="@+id/selectForExportModeButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1.25" android:layout_marginStart="0dp" android:text="انتخاب برای خروجی" android:textSize="11sp" android:textColor="#FFFFFF" android:backgroundTint="#25456F" android:layout_marginEnd="0dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="4dp" android:paddingRight="4dp" />
    </LinearLayout><Button android:id="@+id/exportSegmentsSeparatelyButton" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="1dp" android:text="ذخیرهٔ قطعه‌ها جداگانه (بدون تغییر کدک)" android:textSize="11sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:paddingLeft="4dp" android:paddingRight="4dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
        <Button android:id="@+id/pickStoryboardStartButton" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:text="ثبت شروع از پخش" android:textSize="10sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" />
        <Button android:id="@+id/pickStoryboardEndButton" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:text="ثبت پایان از پخش" android:textSize="10sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="2dp">
        <EditText android:id="@+id/storyboardStartTime" android:layout_width="0dp" android:layout_height="25dp" android:layout_weight="1" android:hint="شروع 00:00" android:text="00:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="11sp" android:padding="4dp" android:backgroundTint="#FFD21F" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تا" android:textColor="#B9D7FF" android:paddingStart="4dp" android:paddingEnd="4dp" />
        <EditText android:id="@+id/storyboardEndTime" android:layout_width="0dp" android:layout_height="25dp" android:layout_weight="1" android:hint="پایان 01:00" android:text="01:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="11sp" android:padding="4dp" android:backgroundTint="#FFD21F" />
        <Button android:id="@+id/applyStoryboardTimeRangeButton" android:layout_width="wrap_content" android:layout_height="24dp" android:text="اعمال زمان" android:textSize="10sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
        <TextView android:id="@+id/selectionText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="انتخاب‌شده: ۰ فریم از ۹۰" android:textColor="#FFD21F" android:textSize="10sp" />
        </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نوار زمان: کشیدن برای حرکت • دو انگشت برای بزرگ‌نمایی • انتخاب قطعه و برش" android:textColor="#B9D7FF" android:textSize="10sp" android:paddingTop="0dp" />

    <com.evc.app.TimelineView android:id="@+id/timelineView" android:layout_width="match_parent" android:layout_height="68dp" android:background="#10213E" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingTop="1dp" android:paddingBottom="2dp">
        <Button android:id="@+id/splitTimelineButton" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:text="Cut" android:textSize="11sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" />
        <Button android:id="@+id/deleteTimelineSegmentButton" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="حذف قطعه انتخابی" android:textSize="11sp" android:textColor="#FFFFFF" android:backgroundTint="#B52C45" android:minHeight="0dp" />
        <Button android:id="@+id/restoreTimelineButton" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="4dp" android:text="بازگردانی قطعات" android:textSize="11sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:scrollbars="vertical">
        </ScrollView>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تنظیم دستی رنگ خروجی (ضریب هر کانال: ۰ تا ۲)" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" android:paddingTop="0dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="3dp">
            <TextView android:id="@+id/redColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="قرمز 1.00" android:textColor="#FF8A8A" android:textSize="10sp" android:gravity="center" />
            <SeekBar android:id="@+id/redColorSeek" android:layout_width="match_parent" android:layout_height="18dp" android:max="200" android:progress="112" android:contentDescription="ضریب کانال قرمز" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/greenColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="سبز 1.00" android:textColor="#8AFFB8" android:textSize="10sp" android:gravity="center" />
            <SeekBar android:id="@+id/greenColorSeek" android:layout_width="match_parent" android:layout_height="18dp" android:max="200" android:progress="100" android:contentDescription="ضریب کانال سبز" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="3dp">
            <TextView android:id="@+id/blueColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آبی 0.82" android:textColor="#8ABEFF" android:textSize="10sp" android:gravity="center" />
            <SeekBar android:id="@+id/blueColorSeek" android:layout_width="match_parent" android:layout_height="18dp" android:max="200" android:progress="82" android:contentDescription="ضریب کانال آبی" />
        </LinearLayout>
    </LinearLayout>

    <Button android:id="@+id/applyColorToSelectedButton" android:layout_width="match_parent" android:layout_height="25dp" android:layout_marginTop="1dp" android:text="ثبت این ترکیب رنگ برای اسلایدهای انتخابی" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFD21F" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حجم هدف (MB):" android:textColor="#FFFFFF" android:textSize="11sp" />
        <EditText android:id="@+id/targetSizeMb" android:layout_width="100dp" android:layout_height="25dp" android:layout_marginStart="8dp" android:inputType="numberDecimal" android:singleLine="true" android:text="20" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:hint="مثلاً 20" android:selectAllOnFocus="true" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="6dp" android:text="حجم تقریبی؛ نه تضمین دقیق" android:textColor="#B9D7FF" android:textSize="10sp" />
    </LinearLayout>






</LinearLayout>