<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07142F"
    android:padding="5dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EVC • استودیو ویرایش ویدیو"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="یک ویدیو انتخاب کنید تا ۱۲۰ فریم در ۸ ردیف ساخته شود"
        android:textColor="#B9D7FF"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingBottom="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="165dp"
        android:background="#000000">
        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ImageView
            android:id="@+id/playerColorPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="پیش‌نمایش رنگ فریم فعلی"
            android:visibility="gone" />
        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="▶

پخش‌کنندهٔ EVC"
            android:textColor="#D7E7FF"
            android:textSize="20sp"
            android:gravity="center"
            android:background="#101F3D" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">
        <Button
            android:id="@+id/timeModeButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="نمایش زمانی"
            android:textSize="11sp"
            android:textColor="#07142F"
            android:backgroundTint="#FFD21F" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">
        <Button
            android:id="@+id/pickStoryboardStartButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="انتخاب زمان شروع"
            android:textSize="10sp"
            android:textColor="#07142F"
            android:backgroundTint="#43D9A3" />
        <Button
            android:id="@+id/pickStoryboardEndButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="انتخاب زمان پایان"
            android:textSize="10sp"
            android:textColor="#07142F"
            android:backgroundTint="#43D9A3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:paddingBottom="2dp">
        <EditText
            android:id="@+id/storyboardStartTime"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="شروع 00:00"
            android:text="00:00"
            android:singleLine="true"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#B9D7FF"
            android:textSize="11sp"
            android:padding="4dp"
            android:backgroundTint="#FFD21F" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تا"
            android:textColor="#B9D7FF"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
        <EditText
            android:id="@+id/storyboardEndTime"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="پایان 01:00"
            android:text="01:00"
            android:singleLine="true"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#B9D7FF"
            android:textSize="11sp"
            android:padding="4dp"
            android:backgroundTint="#FFD21F" />
        <Button
            android:id="@+id/applyStoryboardTimeRangeButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="اعمال زمان"
            android:textSize="10sp"
            android:textColor="#07142F"
            android:backgroundTint="#43D9A3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">
        <TextView
            android:id="@+id/selectionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="انتخاب‌شده: ۰ فریم از ۹۰"
            android:textColor="#FFD21F"
            android:textSize="11sp" />
        <Button
            android:id="@+id/selectAllButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="3dp"
            android:minHeight="0dp"
            android:text="انتخاب همه"
            android:textSize="10sp"
            android:textColor="#07142F"
            android:backgroundTint="#FFD21F" />
        <Button
            android:id="@+id/clearSelectionButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minHeight="0dp"
            android:text="لغو انتخاب"
            android:textSize="10sp"
            android:textColor="#07142F"
            android:backgroundTint="#FFD21F" />
        <Button
            android:id="@+id/deleteSelectedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:minHeight="0dp"
            android:text="حذف بازه‌ها"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B52C45" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="1dp"
        android:paddingBottom="2dp">
        <Button
            android:id="@+id/selectForDeleteModeButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="انتخاب اسلاید برای حذف"
            android:textSize="11sp"
            android:textColor="#07142F"
            android:backgroundTint="#FFD21F" />
        <Button
            android:id="@+id/selectForExportModeButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="انتخاب اسلاید برای خروجی"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#25456F" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="نوار زمان: کشیدن برای حرکت • دو انگشت برای بزرگ‌نمایی • انتخاب قطعه و برش"
        android:textColor="#B9D7FF"
        android:textSize="10sp"
        android:paddingTop="2dp" />

    <com.evc.app.TimelineView
        android:id="@+id/timelineView"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="#10213E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="1dp"
        android:paddingBottom="2dp">
        <Button
            android:id="@+id/splitTimelineButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="Cut"
            android:textSize="10sp"
            android:textColor="#07142F"
            android:backgroundTint="#FFD21F" />
        <Button
            android:id="@+id/deleteTimelineSegmentButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="حذف قطعه انتخابی"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B52C45" />
        <Button
            android:id="@+id/restoreTimelineButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:text="بازگردانی قطعات"
            android:textSize="9sp"
            android:textColor="#07142F"
            android:backgroundTint="#43D9A3" />
    </LinearLayout>

    <Button
        android:id="@+id/exportSegmentsSeparatelyButton"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="2dp"
        android:text="ذخیرهٔ هر فاصلهٔ زمانی در فایل جداگانه (بدون تغییر کدک)"
        android:textSize="11sp"
        android:textColor="#07142F"
        android:backgroundTint="#43D9A3" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="vertical">
        <LinearLayout
            android:id="@+id/storyboardRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تنظیم دستی رنگ خروجی (ضریب هر کانال: ۰ تا ۲)"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:gravity="center"
        android:paddingTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="3dp">
            <TextView android:id="@+id/redColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="قرمز 1.00" android:textColor="#FF8A8A" android:textSize="10sp" android:gravity="center" />
            <SeekBar android:id="@+id/redColorSeek" android:layout_width="match_parent" android:layout_height="28dp" android:max="200" android:progress="112" android:contentDescription="ضریب کانال قرمز" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">
            <TextView android:id="@+id/greenColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="سبز 1.00" android:textColor="#8AFFB8" android:textSize="10sp" android:gravity="center" />
            <SeekBar android:id="@+id/greenColorSeek" android:layout_width="match_parent" android:layout_height="28dp" android:max="200" android:progress="100" android:contentDescription="ضریب کانال سبز" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="3dp">
            <TextView android:id="@+id/blueColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آبی 0.82" android:textColor="#8ABEFF" android:textSize="10sp" android:gravity="center" />
            <SeekBar android:id="@+id/blueColorSeek" android:layout_width="match_parent" android:layout_height="28dp" android:max="200" android:progress="82" android:contentDescription="ضریب کانال آبی" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/applyColorToSelectedButton"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="1dp"
        android:text="ثبت این ترکیب رنگ برای اسلایدهای انتخابی"
        android:textColor="#07142F"
        android:textStyle="bold"
        android:backgroundTint="#FFD21F" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حجم هدف (MB):"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
        <EditText
            android:id="@+id/targetSizeMb"
            android:layout_width="100dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:text="20"
            android:textColor="#FFFFFF"
            android:textColorHint="#B9D7FF"
            android:hint="مثلاً 20"
            android:selectAllOnFocus="true" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:text="حجم تقریبی؛ نه تضمین دقیق"
            android:textColor="#B9D7FF"
            android:textSize="10sp" />
    </LinearLayout>

    <Button
        android:id="@+id/colorizePreviewButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="1dp"
        android:text="خروجی با اعمال تغییرات رنگ و حجم هدف"
        android:textColor="#07142F"
        android:textStyle="bold"
        android:backgroundTint="#D7A6FF" />

    <Button
        android:id="@+id/exportButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="1dp"
        android:text="خروجی بدون تغییر کدک"
        android:textColor="#07142F"
        android:textStyle="bold"
        android:backgroundTint="#43D9A3" />

    <Button
        android:id="@+id/openButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:text="انتخاب ویدیو"
        android:textColor="#07142F"
        android:textStyle="bold"
        android:backgroundTint="#FFD21F" />
</LinearLayout>
